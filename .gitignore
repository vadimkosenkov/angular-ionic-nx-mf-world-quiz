# NOTE: package-lock.json is intentionally committed (reproducible installs, Nx project graph).

# Dependencies
node_modules/

# Build output
dist/
out-tsc/
tmp/
coverage/
*.tsbuildinfo

# Angular / Vite / Vitest caches
.angular/
vitest.config.*.timestamp*
__screenshots__/

# Nx
.nx/cache
.nx/workspace-data
.nx/polygraph
.nx/self-healing
.nx/migrate-runs

# Cypress artefacts
apps/*-e2e/src/videos/
apps/*-e2e/src/screenshots/
dist/cypress/

# Environment files (never commit real credentials; see .env.example)
.env
.env.*
!.env.example

# IDEs and editors
.idea/
.vscode/
*.sublime-workspace

# Claude Code local files
.claude/settings.local.json
.claude/worktrees

# Logs
npm-debug.log*
*.log

# OS files
.DS_Store
Thumbs.db

# Local PGlite database of the API in development (apps/api)
.data/

# iOS (Capacitor). The Xcode project is committed; what `cap sync` or Xcode
# regenerates is not: the copied web bundle, build output and user state.
apps/shell/ios/App/App/public/
apps/shell/ios/App/App/capacitor.config.json
apps/shell/ios/App/build/
apps/shell/ios/App/DerivedData/
apps/shell/ios/App/Pods/
apps/shell/ios/App/output/
**/*.xcuserdatad/
**/xcuserdata/

# Local Netlify folder
.netlify
