{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "importHelpers": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@world-quiz/shared/util": ["./libs/shared/util/src/index.ts"],
      "@world-quiz/quiz/domain": ["./libs/quiz/domain/src/index.ts"],
      "@world-quiz/quiz/domain/testing": [
        "./libs/quiz/domain/src/testing/index.ts"
      ],
      "@world-quiz/quiz/countries": ["./libs/quiz/countries/src/index.ts"],
      "@world-quiz/client/ui": ["./libs/client/ui/src/index.ts"],
      "@world-quiz/client/i18n": ["./libs/client/i18n/src/index.ts"],
      "@world-quiz/client/settings": ["./libs/client/settings/src/index.ts"],
      "@world-quiz/client/quiz-ports": [
        "./libs/client/quiz-ports/src/index.ts"
      ],
      "@world-quiz/client/quiz-feature": [
        "./libs/client/quiz-feature/src/index.ts"
      ],
      "@world-quiz/client/quiz-feature/testing": [
        "./libs/client/quiz-feature/src/testing/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
