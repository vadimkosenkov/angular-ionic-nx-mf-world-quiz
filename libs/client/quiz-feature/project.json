{
  "name": "client-quiz-feature",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/client/quiz-feature/src",
  "prefix": "wq",
  "projectType": "library",
  "tags": ["scope:client", "type:feature"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "shell:esbuild:development",
        "tsConfig": "libs/client/quiz-feature/tsconfig.spec.json",
        "watch": false,
        "setupFiles": ["tools/testing/jsdom-setup.ts"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "ngc -p tsconfig.lib.json --noEmit",
          "tsc -p tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    }
  }
}
