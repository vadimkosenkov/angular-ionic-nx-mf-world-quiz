# World Quiz – environment variables
# Copy to `.env` for local overrides. Never commit real credentials.
# Every variable is documented in docs/development/environment.md.

# ---- API (apps/api) ---------------------------------------------------------
# development | test | production
NODE_ENV=development
# Interface the API binds to. Use 0.0.0.0 inside containers.
HOST=localhost
# Port the API listens on.
PORT=3333
# PostgreSQL connection string. Required in production. When unset outside
# production, the API uses an embedded PGlite database in PGLITE_DIR.
# DATABASE_URL=postgres://localhost:5432/world_quiz
# Directory of the embedded development database (git-ignored).
PGLITE_DIR=.data/pglite

# ---- Sign-in ------------------------------------------------------------------
# HMAC key for access tokens, at least 32 characters. Required in production.
# Unset outside production: a random key per start (everyone is signed out on
# restart). Generate one with: openssl rand -hex 32
# AUTH_JWT_SECRET=
# Accepted Google client ids (comma-separated). Empty disables Google sign-in.
# Client ids are public (the web app ships them); this is the project's
# "World Quiz Web" client, allowed for http://localhost:4200.
GOOGLE_CLIENT_IDS=294520908592-vhhkau8mlstl3s1d105i3efqnopuu0nm.apps.googleusercontent.com
# Accepted Apple client ids: bundle id, Services ID (comma-separated).
# APPLE_CLIENT_IDS=
# Development/E2E sign-in without a provider. Refused in production.
AUTH_DEV_LOGIN=true
# Browser origins allowed to call the API with credentials (comma-separated).
# Default outside production: http://localhost:4200.
# CORS_ORIGINS=
# Mark cookies Secure (HTTPS only). Default: true in production only.
# COOKIE_SECURE=
